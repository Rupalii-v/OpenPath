# Copy this file to .env and fill it in.

# GitHub personal access token (no scopes needed for public data).
# Create one at https://github.com/settings/tokens - without it GitHub allows only 60 requests/hour.
GITHUB_TOKEN=

# Local Ollama server and the Gemma model tag you pulled (check with `ollama list`).
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4

# How long GitHub responses are cached (seconds).
CACHE_TTL_SECONDS=600
